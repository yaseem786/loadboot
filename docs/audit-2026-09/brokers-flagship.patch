From 9333113ac2243ee0eb699d0603a802518a1f2247 Mon Sep 17 00:00:00 2001
From: Yaseen <20190myaseen@gmail.com>
Date: Sun, 6 Sep 2026 10:26:18 +0000
Subject: [PATCH 3/3] Capacity-by-length-of-haul section on the broker and
 shipper pages
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Answers the buyer's real question ('do you have that kind of capacity?') in the buyer's own
vocabulary — local FTL / metro-to-metro corridor / cross-country — and links onward to the three
new carrier pages. Deliberately a SECTION, not a page: 'OTR / regional / local trucking' is
carrier-side search vocabulary, so a page here would miss buyer intent AND make three of our own
pages compete with each other. Copy differs per audience.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NLBisLFyx9zVgJDMVRxc9M
---
 partner_landing_module.py | 50 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/partner_landing_module.py b/partner_landing_module.py
index b0b54e0..f3fc1a2 100644
--- a/partner_landing_module.py
+++ b/partner_landing_module.py
@@ -129,6 +129,53 @@ def _faq(items):
     return rows, '<script type="application/ld+json">%s</script>' % sch
 
 
+# =====================================================================================
+# CAPACITY BY LENGTH OF HAUL — reusable section for the broker and shipper pages.
+#
+# Deliberately a SECTION, not a page. "OTR / regional / local trucking" is CARRIER-side
+# vocabulary — the people typing it are drivers and owner-operators choosing how to run, which
+# is what otr-dispatch.html, regional-truck-dispatch.html and local-truck-dispatch.html are for.
+# Freight buyers use different words entirely ("local FTL carriers", "regional FTL carriers",
+# "FTL shipping near me", metro-to-metro, corridors, national capacity), so repeating the carrier
+# copy here would both miss their intent and make three of our own pages compete with each other.
+# What a buyer DOES want on this page is the answer to "do you have that kind of capacity" —
+# so this answers it in their language and links onward to the carrier pages for crawl depth.
+# =====================================================================================
+def capacity_by_haul_section(aud='broker'):
+    if aud == 'shipper':
+        eyebrow = 'Capacity by length of haul'
+        head = 'Local, regional and long-haul capacity in one network'
+        lead = ('You do not buy &ldquo;a truck&rdquo; &mdash; you buy a delivery window. A cross-dock run across town, a metro-to-metro corridor '
+                'and a cross-country move are three different pools of carriers, and asking one carrier to be all three is how service slips. '
+                'Every posting is matched against the carriers that actually run that length of haul.')
+        who = 'shipper'
+    else:
+        eyebrow = 'Capacity by length of haul'
+        head = 'Post a short run and a cross-country run to the same network'
+        lead = ('The carrier who wants your 180-mile drop is rarely the carrier who wants your 1,600-mile move, and the difference is not '
+                'preference &mdash; it is how their week is built. Carriers tell us which lengths they run and re-confirm the truck daily, so a '
+                'posting only reaches the pool that will actually take it.')
+        who = 'broker'
+    tiles = _tiles([
+        ('&#127968;', 'Local &mdash; up to 250 miles',
+         'Short runs and metro work, out and back inside the day. Many of these carriers run under the FMCSA short-haul rules, so their day is '
+         'built around returning to the same yard &mdash; dock time is the constraint, not distance. '
+         '<a href="local-truck-dispatch.html" style="color:#0883F7;font-weight:700">How local carriers run &rarr;</a>'),
+        ('&#128506;', 'Regional &mdash; 250 to 800 miles',
+         'Corridor and metro-to-metro freight, usually home on weekends. This is where most truckload volume in the country actually sits, so it '
+         'is the deepest pool and the easiest to cover repeatedly on the same lane. '
+         '<a href="regional-truck-dispatch.html" style="color:#0883F7;font-weight:700">How regional carriers run &rarr;</a>'),
